{
  "name": "marzia-saidi-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run format:check && npm run lint && npm run validate:content && npm run validate:scene && npm run validate:scroll && npm run typecheck && npm run build",
    "validate:scene": "node --import tsx scripts/check-scene.ts",
    "prepare:rocks": "node scripts/prepare-rocks.mjs",
    "prepare:selected-work": "node scripts/prepare-rocks.mjs --selected-work assets-src/selected-work",
    "prepare:hero": "node scripts/prepare-rocks.mjs --hero assets-src/hero",
    "prepare:intro-arch": "node scripts/prepare-rocks.mjs --intro-arch assets-src/intro",
    "prepare:monolith-screens": "node scripts/prepare-monolith-screens.mjs",
    "capture:my-world": "node scripts/capture-my-world.mjs",
    "check:my-world": "node scripts/check-my-world.mjs",
    "prepare:rift": "node scripts/prepare-rift.mjs",
    "prepare:aerial": "node scripts/aerial-terrain.mjs",
    "prepare:cabin": "node scripts/prepare-cabin-assets.mjs",
    "validate:scroll": "node --import tsx --test scripts/check-project-stepper.ts scripts/check-scroll-catch.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "meshoptimizer": "0.22.0",
    "prettier": "^3.9.7",
    "sharp": "0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
